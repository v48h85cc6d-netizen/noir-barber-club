# Server-side settings for the email verification functions (netlify/functions).
# Set these in Netlify → Site configuration → Environment variables (scope: Functions).
# NEVER commit real values and never prefix them with VITE_ (that would put them in the website bundle).

# Random secret, at least 32 characters (e.g. `openssl rand -hex 32`)
VERIFICATION_SECRET=

# Sender (defaults shown)
EMAIL_FROM=projects@veltri-x-agency.com
EMAIL_FROM_NAME=NOIR BARBER CLUB

# Option A — Resend (recommended): API key of a Resend account where veltri-x-agency.com is verified
RESEND_API_KEY=

# Option B — SMTP of the mailbox provider that hosts projects@veltri-x-agency.com
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=projects@veltri-x-agency.com
# SMTP_PASS=
# SMTP_SECURE=false
